{
  "name": "billready",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "kit": "tsx scripts/generate-kit.ts",
    "test": "tsx --test tests/domain.test.ts tests/adapter.test.ts tests/tracing.test.ts tests/live-boundaries.test.ts tests/ui-contracts.test.ts tests/employee.test.ts tests/dev-files.test.ts",
    "test:e2e": "playwright test",
    "reset": "tsx scripts/reset.ts",
    "box:inspect": "tsx scripts/inspect-box.ts",
    "test:live-view": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.20.0",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "openai": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
