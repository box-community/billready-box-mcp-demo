# Rehearsal mode works with no credentials.
BILLREADY_ADAPTER=development
PORT=4310
DEMO_DATE=2026-10-21
# Live mode uses Box's REMOTE MCP endpoint, never a replacement server.
BOX_MCP_URL=https://mcp.box.com
BOX_MCP_TOKEN=
BOX_DEMO_ROOT_ID=
OPENAI_API_KEY=
# Choose a Responses API function-calling model enabled on your OpenAI account.
OPENAI_MODEL=
# Optional absolute file path for remapping semantic argument names to actual MCP schemas.
# BOX_MCP_SCHEMA_MAP=/absolute/path/schema-map.json
# DATA_DIR=./data
# Preferred: authorize the demo user through the local OAuth flow.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=http://127.0.0.1:4310/auth/box/callback
# Tokens are stored server-side in data/box-oauth.json with mode 0600; never in the kit.
# Default live agent: Box AI Q&A planning through remote Box MCP. No OpenAI key required.
AGENT_PROVIDER=box
# Optional: AGENT_PROVIDER=openai uses OPENAI_API_KEY + OPENAI_MODEL for the conversation layer.
