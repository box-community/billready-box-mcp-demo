# Local sample workflow; no credentials needed.
BILLREADY_ADAPTER=development
PORT=4310
DEMO_DATE=2026-10-21
# Live employee mode uses Box's hosted MCP server and individual OAuth sign-ins.
BOX_MCP_URL=https://mcp.box.com
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=http://127.0.0.1:4310/auth/box/callback
AGENT_PROVIDER=box
# Employee credentials are stored server-side with mode 0600.
# EMPLOYEE_AUTH_FILE=./data/employee-auth/accounts.json
# EMPLOYEE_DATA_DIR=./data/employees
# DATA_DIR=./data/development
# BOX_MCP_TOKEN and BOX_DEMO_ROOT_ID are not used by live employee sessions.
# Optional conversation provider; unnecessary for Box AI.
OPENAI_API_KEY=
OPENAI_MODEL=
