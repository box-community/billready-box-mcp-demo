{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "client": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "shortName": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "milestones": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "complete": {
            "type": "boolean"
          },
          "acceptanceRequired": {
            "type": "boolean"
          },
          "accepted": {
            "type": "boolean"
          },
          "issued": {
            "type": "boolean"
          },
          "paidCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "issuedDate": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "cents",
          "complete",
          "acceptanceRequired",
          "accepted",
          "issued",
          "paidCents"
        ]
      }
    }
  },
  "required": [
    "id",
    "client",
    "name",
    "shortName",
    "contact",
    "email",
    "owner",
    "color",
    "progress",
    "milestones"
  ],
  "description": "BillReady project record. The server additionally checks unique milestone IDs, paid amounts not exceeding milestone values, and a safe-integer total."
}
